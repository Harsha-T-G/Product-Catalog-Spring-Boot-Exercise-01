# Copy to .env for local development. Never commit .env to Git.
# POSTGRES_PASSWORD and DB_PASSWORD must match (Compose initializes the DB user once).
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/product_catalog
DB_USERNAME=root
DB_PASSWORD=

# Optional development sample users. All three passwords are required to seed.
CATALOG_VIEWER_USERNAME=viewer
CATALOG_VIEWER_PASSWORD=
CATALOG_EDITOR_USERNAME=editor
CATALOG_EDITOR_PASSWORD=
CATALOG_ADMIN_USERNAME=admin
CATALOG_ADMIN_PASSWORD=
